# 访问密码：所有设备登录用。
#
# Docker Compose 用 ${APP_PASSWORD:?...} 校验这个变量，未设置或为空都会直接
# 报错，所以走 Docker 部署时必须填一个非空值：
#   APP_PASSWORD=$(openssl rand -base64 24)
# 只有在本机直接 `node server/index.ts` 调试时，留空才表示不启用登录。
APP_PASSWORD=

# 数据目录：SQLite 数据库、附件原件、Cookie 签名密钥
# 直接跑 Node 时默认 ./data；Docker 里由 compose 固定为 /data，此处无需改动
DATA_DIR=./data

# 监听端口
PORT=3000

# 仅 Docker：要运行的镜像。仓库名与默认值不同时必须覆盖，
# 例如 DEEPCHAT_IMAGE=ghcr.io/your-name/your-repo:latest
# 想固定版本可写 :v0.2.0 或 :sha-abc1234
DEEPCHAT_IMAGE=

# 首次启动自动创建端点与默认模型（已有配置不会被覆盖）
DEEPSEEK_API_KEY=
# 可选：自定义兼容端点，留空用 https://api.deepseek.com
API_ORIGIN=
# 可选：默认模型名，留空用 deepseek-flash
API_MODEL=
