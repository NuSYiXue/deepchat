# ============ 必填 ============

# 访问密码：所有设备登录用，随便定一个 20 位左右、别用常见词的密码。
# Docker Compose 用 ${APP_PASSWORD:?...} 校验，未设置或为空会直接报错：
#   required variable APP_PASSWORD is missing a value
# 只有在本机直接 `node server/index.ts` 调试时，留空才表示不启用登录。
APP_PASSWORD=

# ============ 可选 ============

# 内置 DeepSeek 端点的 API Key。
# 填了会在首次启动时自动配好，省掉登录后手动粘贴；
# 不填也没关系，登录后在「设置 → 模型」里粘贴 Key 效果完全一样。
DEEPSEEK_API_KEY=

# 仅 Docker：要运行的镜像。仓库名与默认值不同时必须覆盖，
# 例如 DEEPCHAT_IMAGE=ghcr.io/your-name/your-repo:latest
# 想固定版本可写 :v0.2.0 或 :sha-abc1234
DEEPCHAT_IMAGE=

# 播种端点用的自定义地址与模型名，留空分别用
# https://api.deepseek.com 与 deepseek-flash
API_ORIGIN=
API_MODEL=

# ============ 仅本机直跑 Node 时生效 ============

# 数据目录：SQLite 数据库、附件原件、Cookie 签名密钥。
# Docker 部署下被 docker-compose.yml 固定为 /data，改了也不起作用；
# 想换宿主目录请改 compose 的 volumes（- ./data:/data 的左边）。
DATA_DIR=./data

# 监听端口（Docker 下固定为 3000）
PORT=3000
